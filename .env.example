APP_NAME=VideoToSRT
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/database/app.db

STORAGE_PATH=./storage
MODEL_PATH=./models
LOGS_PATH=./logs

# Retention / automatic cleanup in days (0 disables the rule).
# Source videos (uploads) are NEVER deleted automatically.
RETENTION_TEMP_DAYS=7
RETENTION_AUDIO_DAYS=14
RETENTION_ARTIFACT_DAYS=0

# WHISPER_DEVICE: auto | cuda | cpu
# "auto" uses CUDA when an CUDA-enabled CTranslate2 build is available,
# otherwise falls back to CPU. On native Windows, CUDA builds of CTranslate2
# are not available - run the worker under WSL2/Docker for GPU inference.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

WORKER_POLL_INTERVAL=2
MAX_GPU_WORKERS=1

MAX_UPLOAD_SIZE_GB=20

ENABLE_VAD=true
ENABLE_WORD_TIMESTAMPS=true

LOG_LEVEL=INFO
