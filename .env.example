APP_NAME=VideoToSRT
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/database/app.db

STORAGE_PATH=./storage
MODEL_PATH=./models
LOGS_PATH=./logs

# Retention / automatic cleanup in days (0 disables the rule).
# Source videos (uploads) are NEVER deleted automatically.
RETENTION_TEMP_DAYS=7
RETENTION_AUDIO_DAYS=14
RETENTION_ARTIFACT_DAYS=0

# WHISPER_DEVICE: auto | cuda | cpu
# "auto" uses CUDA when an CUDA-enabled CTranslate2 build is available,
# otherwise falls back to CPU. On native Windows, CUDA builds of CTranslate2
# are not available - run the worker under WSL2/Docker for GPU inference.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

WORKER_POLL_INTERVAL=2
MAX_GPU_WORKERS=1

MAX_UPLOAD_SIZE_GB=20

ENABLE_VAD=true
ENABLE_WORD_TIMESTAMPS=true

# Google Cloud Translation API (subtitle translation in the editor).
# Create an API key in Google Cloud Console -> APIs & Services -> Credentials
# (enable the "Cloud Translation API"), then paste it here and restart.
# Leave empty to disable the Translate feature.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=30
# Monthly character budget (Google meters per character; free tier = 500000).
# Translate is rejected with a clean error once the budget is exhausted.
# 0 = unlimited.
GOOGLE_TRANSLATE_MONTHLY_CHAR_LIMIT=500000

# Ollama — local translation via TranslateGemma (free, no metering).
# Install Ollama (https://ollama.com), then:  ollama pull translategemma:12b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATE_MODEL=translategemma:12b
# Per-request timeout in seconds (local LLM batches can take minutes on CPU).
OLLAMA_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
